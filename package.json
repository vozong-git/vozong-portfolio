{
  "name": "vozong-portfolio",
  "version": "1.0.0",
  "description": "Sound Engineer Portfolio (Studio Noir) — Express backend with Google OAuth (single-admin) and Google Drive image storage.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/app.css -o ./public/assets/app.css --watch",
    "prestart": "npm run build:css",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "node -e \"require('./src/db').init(); console.log('DB initialized')\"",
    "gen:og": "node scripts/gen-og.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
