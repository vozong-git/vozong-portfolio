# ─────────────────────────────────────────────────────────────
#  Studio Noir Portfolio — environment configuration
#  Copy this file to ".env" and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=production
# Public base URL of THIS server. Must match the redirect URI registered
# in Google Cloud Console. No trailing slash.
BASE_URL=http://localhost:8080

# ── Google OAuth 2.0 (create at https://console.cloud.google.com) ──
# APIs & Services → Credentials → Create OAuth client ID → "Web application"
# Authorized redirect URI must be:  ${BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# The ONLY Google account allowed to sign in as administrator.
# Anyone else who authenticates is rejected and sees the public portfolio only.
ADMIN_EMAIL=you@gmail.com

# ── Secrets (generate random 32+ byte strings) ──
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Encrypts the Drive refresh token at rest in the SQLite DB.
TOKEN_ENC_KEY=change-me-to-a-64-hex-char-key

# ── Google Drive ──
# Folder name where uploaded album covers / concert posters are stored.
DRIVE_IMAGE_FOLDER=portfolio_image
# Folder name for uploaded reference audio (WAV/AIF/MP3). Leave blank to disable.
DRIVE_AUDIO_FOLDER=portfolio_audio

# ── Uploads ──
MAX_UPLOAD_MB=100

# ── YouTube (optional) ──
# YouTube Data API v3 key. Lets the project detail page resolve "artist title"
# to the real video's watch page (plays embedding-disabled videos). Create one
# in Google Cloud Console → APIs & Services → Credentials (enable "YouTube Data
# API v3"). Leave blank to fall back to a plain YouTube search link.
YOUTUBE_API_KEY=

# Storage location for the SQLite database file.
DB_PATH=./data/portfolio.db
